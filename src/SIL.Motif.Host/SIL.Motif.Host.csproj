<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Projection\SIL.Motif.Projection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIL.LCModel" Version="11.0.0-beta0150" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Pins the otherwise-transitive libpalaso packages so a local override (see AGENTS.md) applies here too. -->
  <ItemGroup Condition="'$(MotifLocalPalasoActive)' == 'true'">
    <PackageReference Include="SIL.WritingSystems" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core" Version="$(SilLibPalasoVersion)" />
  </ItemGroup>

</Project>
