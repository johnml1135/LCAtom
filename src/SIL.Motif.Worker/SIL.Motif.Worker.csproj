<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WorkerProductVersion Condition="'$(Version)' == ''">1.0.0</WorkerProductVersion>
    <WorkerProductVersion Condition="'$(Version)' != ''">$(Version)</WorkerProductVersion>
    <WorkerProtocolMinimum>1</WorkerProtocolMinimum>
    <WorkerProtocolMaximum>1</WorkerProtocolMaximum>
    <WorkerMetadataCanonicalJson>{&quot;productVersion&quot;:&quot;$(WorkerProductVersion)&quot;,&quot;min&quot;:$(WorkerProtocolMinimum),&quot;max&quot;:$(WorkerProtocolMaximum),&quot;capabilities&quot;:[&quot;baseline.v1&quot;,&quot;jobs.v1&quot;]}</WorkerMetadataCanonicalJson>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
    <ProjectReference Include="..\SIL.Motif.Client\SIL.Motif.Client.csproj" />
    <ProjectReference Include="..\SIL.Motif.Host\SIL.Motif.Host.csproj" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <UsingTask TaskName="EncodeUtf8Base64" TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Contents ParameterType="System.String" Required="true" />
      <Base64 ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Base64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(Contents));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateWorkerBuildMetadata" BeforeTargets="CoreCompile">
    <EncodeUtf8Base64 Contents="$(WorkerMetadataCanonicalJson)">
      <Output TaskParameter="Base64" PropertyName="_WorkerMetadataCanonicalBase64" />
    </EncodeUtf8Base64>
    <ItemGroup>
      <_WorkerMetadataLines Include="namespace SIL.Motif.Worker;" />
      <_WorkerMetadataLines Include="{" />
      <_WorkerMetadataLines Include="internal static class WorkerBuildMetadataGenerated" />
      <_WorkerMetadataLines Include="{" />
      <_WorkerMetadataLines Include="  public const string CanonicalJsonBase64 = &quot;$(_WorkerMetadataCanonicalBase64)&quot;%3B" />
      <_WorkerMetadataLines Include="}" />
      <_WorkerMetadataLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)WorkerBuildMetadata.g.cs" Overwrite="true"
      Lines="@(_WorkerMetadataLines)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WorkerBuildMetadata.g.cs" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="WriteExactUtf8File" TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Contents ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.IO.File.WriteAllText(File, Contents, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PublishWorkerBuildMetadata" AfterTargets="Publish">
    <WriteExactUtf8File File="$(PublishDir)worker.metadata.json" Contents="$(WorkerMetadataCanonicalJson)" />
  </Target>
</Project>
