<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Single source of truth for the pinned SIL.LCModel version, reused below by both the
      PackageReference and the AssemblyMetadata attribute that lets ModelSource/ModelPathResolver.cs
      read the version back at runtime without a second hardcoded copy of the string. MOT-2
      requires the resolved model-file path to be recorded, and the version is half of that path
      (docs/plan-motif.md, MOT-2 acceptance: "which path was used must be recorded").
    -->
    <SilLCModelPackageVersion>11.0.0-beta0150</SilLCModelPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      This project never calls into SIL.LCModel — it only reads the MasterLCModel.xml the package
      ships under contentFiles/ (see ModelSource/ModelPathResolver.cs). The PackageReference exists
      solely so the pinned version above is the one MSBuild actually restores, keeping the
      AssemblyMetadata value below honest rather than a second guess.
    -->
    <PackageReference Include="SIL.LCModel" Version="$(SilLCModelPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SilLCModelPackageVersion" Value="$(SilLCModelPackageVersion)" />
  </ItemGroup>

</Project>
